# DeepSeek (OpenAI-compatible API)
SRE_ENVIRONMENT=development
SRE_LOG_FORMAT=text
SRE_LOG_LEVEL=INFO
SRE_SEED_DEMO_DATA=true
SRE_REQUIRE_REAL_DATA_SOURCE=false
# Set DATABASE_URL for shared PostgreSQL. Omit only for local SQLite fallback.
DATABASE_URL=
# Emergency local-only override. Production readiness rejects SQLite by default.
SRE_ALLOW_PRODUCTION_SQLITE=false

# Commercial delivery is one isolated workspace per deployment in the current release.
SRE_WORKSPACE_ID=default
SRE_WORKSPACE_NAME=Default workspace
SRE_PLAN=trial
# 0 means unlimited (normally reserved for a contracted enterprise plan).
SRE_MONTHLY_REQUEST_LIMIT=1000
# Trial end is persisted on first initialization and is not extended by restarts.
# Set an explicit UTC timestamp when the commercial agreement requires one.
SRE_SUBSCRIPTION_STATUS=trialing
SRE_TRIAL_DAYS=14
SRE_TRIAL_ENDS_AT=
# Used as the access/grace boundary for past_due or canceled paid subscriptions.
SRE_CURRENT_PERIOD_END=
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# Optional: override defaults
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# API authentication. Keep enabled outside isolated tests.
SRE_AUTH_ENABLED=true
SRE_VIEWER_API_KEY=
SRE_OPERATOR_API_KEY=
SRE_ADMIN_API_KEY=replace_with_a_long_random_secret

# Production secrets must come from environment/Kubernetes Secret/Vault.
# Never enable this outside an isolated local demo.
SRE_ALLOW_INSECURE_DB_SECRETS=false

# Optional: real read-only telemetry source
# If frontend runtime setting is configured, it will override this value.
SRE_DATA_API_BASE=http://127.0.0.1:9000
SRE_DATA_API_TOKEN=

# Outbound SSRF protection. Private/local destinations require an explicit host pattern.
SRE_OUTBOUND_HOST_ALLOWLIST=127.0.0.1,localhost
SRE_ALLOW_PRIVATE_NETWORK_TARGETS=false

# Optional: Prometheus / Loki style observability backends
PROMETHEUS_BASE_URL=http://127.0.0.1:9090
PROMETHEUS_TOKEN=
PROMETHEUS_SERVICE_LABEL=service
PROM_QUERY_UP=sum(up{service_selector})
PROM_QUERY_REPLICAS=count(up{service_selector})
PROM_QUERY_ERROR_RATE=100 * sum(rate(http_requests_total{service_selector_with_status_5xx}[5m])) / clamp_min(sum(rate(http_requests_total{service_selector}[5m])), 0.001)
PROM_QUERY_CPU=100 * avg(rate(process_cpu_seconds_total{service_selector}[5m]))
PROM_QUERY_MEMORY=avg(process_resident_memory_bytes{service_selector}) / 1024 / 1024
PROM_QUERY_LATENCY_P95_MS=1000 * histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{service_selector}[5m])) by (le))
PROM_ALERT_QUERY=ALERTS{alertstate="firing",service="{service_name}"}

LOKI_BASE_URL=http://127.0.0.1:3100
LOKI_TOKEN=
LOKI_SERVICE_LABEL=service
LOKI_QUERY_TEMPLATE={{{label}="{service_name}"}}

# Optional: Kubernetes API for rollout / pod / event level observability
K8S_API_BASE=
K8S_API_TOKEN=
K8S_NAMESPACE=default
K8S_SERVICE_LABEL=app

# Optional: execution guard for high-risk write actions
EXECUTION_GUARD_ENABLED=true
EXECUTION_GUARD_TOKEN=

# Controlled change executor: simulation or webhook.
SRE_CHANGE_EXECUTOR=simulation
# Production writes remain disabled until a verified webhook executor is configured.
SRE_PRODUCTION_WRITE_ENABLED=false
SRE_CHANGE_EXECUTOR_WEBHOOK_URL=
SRE_CHANGE_EXECUTOR_TOKEN=
SRE_CHANGE_EXECUTOR_TIMEOUT_SECONDS=30

# synchronous for local/demo; queued runs approved changes through backend.worker.
SRE_CHANGE_EXECUTION_MODE=synchronous
SRE_CHANGE_JOB_MAX_ATTEMPTS=1
SRE_CHANGE_JOB_MAX_REDRIVES=3
SRE_CHANGE_WORKER_POLL_SECONDS=1
SRE_WORKER_HEARTBEAT_INTERVAL_SECONDS=10
# queued readiness fails when every Worker heartbeat is older than this value.
SRE_WORKER_HEARTBEAT_MAX_AGE_SECONDS=90

# Evidence budgets protect model context, latency, and per-incident cost.
SRE_EVIDENCE_MAX_ITEMS=20
SRE_EVIDENCE_MAX_TEXT_CHARS=4000
SRE_EVIDENCE_MAX_TOTAL_BYTES=65536
# Used for cost attribution; keep in sync with the provider contract.
# Values are USD per one million tokens. Zero records tokens without estimated cost.
SRE_LLM_INPUT_COST_PER_MILLION_USD=0
SRE_LLM_OUTPUT_COST_PER_MILLION_USD=0
# Paid-pilot value report assumptions. Use the contracted monthly price and
# fully loaded customer/support labor rates; values are non-negative USD.
SRE_PLAN_PRICE_USD_MONTHLY=0
# Optional metered overage added to a finalized monthly billing statement.
SRE_REQUEST_OVERAGE_USD_PER_1000=0
SRE_INFRA_COST_USD_MONTHLY=0
SRE_CUSTOMER_HOURLY_COST_USD=0
SRE_SUPPORT_HOURLY_COST_USD=0

# Data retention. Purge is dry-run unless explicitly applied with PURGE:<workspace-id>.
SRE_RETENTION_LOG_DAYS=30
SRE_RETENTION_CHAT_DAYS=90
SRE_RETENTION_TASK_DAYS=180
SRE_RETENTION_USAGE_DAYS=400
SRE_RETENTION_INCIDENT_DAYS=730
SRE_RETENTION_CHANGE_DAYS=730
SRE_RETENTION_REVOKED_KEY_DAYS=730
SRE_RETENTION_AUDIT_DAYS=2555
# Production defaults to true: usage cannot be purged until every affected UTC
# month has a finalized billing statement.
SRE_REQUIRE_FINALIZED_BILLING_BEFORE_USAGE_PURGE=true
SRE_AGENT_DB_PATH=sre_agent.db
